  "setup": {
    "~/code/app": "npm ci"
  },
  "flow": {
    "plan": "always",
    "review": "every",
    "debugger_after": 3,
    "workers": 6,
    "merge": "auto"
  },
  "theme": {"accent": "blue"}
}
