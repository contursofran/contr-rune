{
  "kit": "/work/contr/kit",
  "profiles": {
    "builder": {
      "argv": ["claude", "--model=opus", "--effort", "high"]
    },
    "planner-high": {
      "argv": ["claude", "--model", "opus", "--effort", "high"],
      "agent": "planner"
    }
