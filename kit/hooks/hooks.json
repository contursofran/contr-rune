{
  "description": "Workers: a turn that ends without hc send still reports to the coordinator.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CONTR_COORDINATOR$HC_TERMINAL_ID\" ] || contr-rune hook stop || exit 1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
