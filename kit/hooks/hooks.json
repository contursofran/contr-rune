{
  "description": "Workers: a turn that ends without hc send still reports to the coordinator. Coordinators: save state before a compaction, restore it after.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CONTR_COORDINATOR$HC_TERMINAL_ID\" ] || contr-rune hook stop || exit 1",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CONTR_COORDINATOR$HC_TERMINAL_ID\" ] || contr-rune hook session-start || exit 1",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|TaskCreate|TaskUpdate|mcp__claude-artifacts__.*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$HC_TERMINAL_ID\" ] || contr-rune hook post-tool || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$HC_TERMINAL_ID\" ] || contr-rune hook prompt || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
